  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  dialoguePanel: {fileID: 1562892792}
  dialogueText: {fileID: 278589790}
  nameText: {fileID: 528573415}
  lines:
  - speaker: Player
    text: "Hello, T\xF4i \u0111ang c\xF3 1 m\u1EA3nh b\u1EA3n \u0111\u1ED3 kho b\xE1u
      c\u1EE7a b\u1ED1 t\xF4i \u0111\u1EC3 l\u1EA1i"
  - speaker: Player
    text: "B\u1EA1n c\xF3 mu\u1ED1n \u0111i kh\xE1m ph\xE1 v\xE0 truy t\xECm n\xF3
      c\xF9ng t\xF4i kh\xF4ng."
  - speaker: Monk
    text: "Xin l\u1ED7i, t\xF4i kh\xF4ng th\u1EC3 \u0111i c\xF9ng b\u1EA1n."
  - speaker: Monk
    text: "Nh\u01B0ng ch\xFAc b\u1EA1n may m\u1EAFn v\xE0 t\xECm \u0111\u01B0\u1EE3c
      kho b\xE1u tr\u1EDF v\u1EC1 nh\xE9"
  - speaker: 'Player '
    text: "Thankyou. V\u1EADy t\u1EA1m bi\u1EC7t nh\xE9."
